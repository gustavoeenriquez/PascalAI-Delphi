; La configuración del ejemplo: la misma de un programa de pai (Engine.LoadPackageConfig la carga).
; Las claves nunca van aquí: $NOMBRE se toma de la variable de entorno.

[providers]
; ollama = url=http://localhost:11434/v1
; claude = url=https://api.anthropic.com/v1; key=$ANTHROPIC_API_KEY

[models]
; Cambia los modelos sin tocar el código (el del código es mock/pasos). Quita el ';' de un par:
; Redactor = ollama/gemma4:e4b
; Explorador = ollama/gemma4:e4b
; Redactor = claude/claude-haiku-5-5
; Explorador = claude/claude-haiku-5-5

[skills]
; las skills del proyecto: tools skill('estilo') lee ia/estilo/SKILL.md
estilo = ia/estilo

[auto]
; tools auto: qué puede buscar e instalar el modelo del registry, y qué se le pregunta a la persona
permitir = mcp-calculator, skill-*
aprobar = instalar
